{
  "name": "aakashremesh-com",
  "private": true,
  "type": "module",
  "description": "aakashremesh.com: static site plus booking and contact functions (Vercel).",
  "scripts": {
    "build": "node tools/bundle.mjs && python3 tools/build.py",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "npm run build && node --test --test-concurrency=1 tests/e2e/*.e2e.mjs",
    "test:all": "npm test && npm run test:e2e"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.1",
    "motion": "^14.0.0",
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright-core": "^1.49.1"
  }
}
